<!DOCTYPE html>
<html lang="pt-br">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Perfil - Hub de Ocorrências</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <nav class="navbar">
    <span class="logo">👤 Perfil</span>
    <span><a href="/">Voltar</a></span>
  </nav>

  <div class="container form-container">
    <h2>Meu Perfil</h2>

    <% if (typeof erro !== 'undefined' && erro) { %>
      <div class="alert erro"><%= erro %></div>
    <% } %>
    <% if (typeof sucesso !== 'undefined' && sucesso) { %>
      <div class="alert" style="background:#e8f5e9;color:#2e7d32;border:1px solid #c8e6c9"><%= sucesso %></div>
    <% } %>

    <div class="card" style="padding:1.5rem;margin-bottom:1.5rem">
      <p><strong>Nome:</strong> <%= user.nome %></p>
      <p><strong>Usuário:</strong> <%= user.username %></p>
      <p><strong>Tipo:</strong>
        <% if (user.role === 'admin') { %>
          <span class="badge" style="background:#1a2a3a;color:#64b5f6">Administrador</span>
        <% } else { %>
          <span class="badge" style="background:#2a1a3a;color:#ce93d8">Usuário</span>
        <% } %>
      </p>
    </div>

    <h2>Alterar Senha</h2>
    <form action="/profile" method="POST" style="margin-top:1rem">
      <div class="form-group">
        <label>Senha atual *</label>
        <input type="password" name="senhaAtual" required>
      </div>
      <div class="form-group">
        <label>Nova senha *</label>
        <input type="password" name="novaSenha" required minlength="4">
      </div>
      <div class="form-group">
        <label>Confirmar nova senha *</label>
        <input type="password" name="confirmarSenha" required minlength="4">
      </div>
      <button type="submit" class="btn btn-full">Salvar</button>
    </form>

    <p style="margin-top:1.5rem;text-align:center">
      <a href="/users">⚙️ Gerenciar usuários</a>
    </p>
  </div>
</body>
</html>
